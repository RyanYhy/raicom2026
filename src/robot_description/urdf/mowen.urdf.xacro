<?xml version="1.0" encoding="utf-8"?>
<robot name="mowen_zc1" xmlns:xacro="http://wiki.ros.org/xacro">

    <!-- 
         已移除: <xacro:arg name="ns" ...> 
         已移除: <xacro:property name="prefix" ...>
         现在直接使用全局名称。
    -->

    <!-- 定义材质 -->
    <material name="BrightPink">
        <color rgba="1 0.41 0.7 1"/>
    </material>
    <material name="White">
        <color rgba="0.7 0.7 0.7 1"/>
    </material>

    <!-- 定义一个虚拟的根link, 所有坐标都基于它 -->
    <!-- 移除 ${prefix} 前缀 -->
    <link name="base_footprint"/>

    <xacro:macro name="common_link" params="name material *origin">
        <!-- 移除 ${prefix} 前缀，直接使用 ${name} -->
        <link name="${name}">
            <visual>
                <geometry>
                    <!-- 
                      保持原路径: package://robot_description/...
                    -->
                    <mesh filename="package://robot_description/meshes/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <material name="${material}"/>
            </visual>
            <collision>
                <geometry>
                    <mesh filename="package://robot_description/meshes/${name}.STL"/>
                </geometry>
                <origin xyz="0 0 0" rpy="0 0 0"/>
            </collision>
            <xacro:insert_block name="origin"/>
        </link>
    </xacro:macro>

    <xacro:macro name="fixed_joint" params="name parent child xyz rpy">
        <!-- 移除 joint 名称中的 ${prefix} -->
        <joint name="${name}" type="fixed">
            <!-- 移除 parent 和 child 引用中的 ${prefix} -->
            <parent link="${parent}"/>
            <child link="${child}"/>
            <origin xyz="${xyz}" rpy="${rpy}"/>
        </joint>
    </xacro:macro>
    
    <!-- 宏调用保持不变，但生成的名称将不再带前缀 -->
    <common_link name="base_link" material="BrightPink">
        <inertial>
            <origin xyz="0.00498 0.00005 -0.0121" rpy="0 0 0"/>
            <mass value="0.4862"/>
            <inertia
                ixx="0.00196" ixy="0.0" ixz="0.00014"
                iyy="0.00457" iyz="0.0" izz="0.00493"/>
        </inertial>
    </common_link>

    <fixed_joint name="base_joint" parent="base_footprint" child="base_link" xyz="0.0 0.0 0.0815" rpy="0 0 0"/>

</robot>