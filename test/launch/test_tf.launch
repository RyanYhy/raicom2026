<launch>
  <!-- ============================================================
       test_tf.launch —— 测试环境静态 TF (2026-08-14)
       ============================================================
       测试模式(不起底盘/AMCL/EKF)下补齐 TF 树:
         map -> odom -> base_footprint -> base_link -> camera_link
       比赛时由 nav_competition_2026.launch 的 AMCL/EKF/bringup 提供真实
       变换, 不要跑本文件 (会与真实 TF 冲突)。
       用法: roslaunch raicom2026 test_tf.launch
       ============================================================ -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_map_odom"
        args="0 0 0 0 0 0 map odom"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_odom_base"
        args="0 0 0 0 0 0 odom base_footprint"/>
  <node pkg="tf2_ros" type="static_transform_publisher" name="tf_base_cam"
        args="0.2 0 0.2 0 0 0 base_link camera_link"/>
</launch>
